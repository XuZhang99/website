---
import { Icon } from 'astro-icon/components';

const modelTypes = ['LLM', 'VLM', 'DiT', 'REC'];
const hardwareTypes = ['NPU', 'MLU', 'GPU'];
---

<figure
  class="inference-flow scroll-fade mx-auto mt-12 max-w-5xl overflow-hidden rounded-3xl border border-black/10 bg-white/80 p-5 sm:mt-14 sm:p-8 dark:border-white/10 dark:bg-neutral-950/80"
>
  <div class="mb-7 flex flex-wrap items-center justify-between gap-3">
    <p class="text-sm font-medium text-heading dark:text-white">Many models. Many accelerators. One inference layer.</p>
  </div>

  <div class="flow-layout">
    <div class="flow-endpoint">
      <p class="flow-label"><span>01</span> Models</p>
      <ul class="grid grid-cols-2 gap-2">
        {
          modelTypes.map((model) => (
            <li class="rounded-lg border border-black/[0.07] bg-white px-3 py-3 text-center font-mono text-sm font-medium dark:border-white/10 dark:bg-neutral-900">
              {model}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="flow-connector" aria-hidden="true"><Icon name="tabler:chevron-right" class="h-4 w-4" /></div>

    <div class="flow-engine">
      <p class="flow-label"><span>02</span> Unified engine</p>
      <div class="rounded-2xl border border-[#EB2700]/25 bg-[#EB2700]/[0.04] p-5 text-center dark:bg-[#EB2700]/[0.08]">
        <div class="flex items-center justify-center gap-2.5">
          <Icon name="tabler:cpu" class="h-7 w-7 text-primary" />
          <span class="text-3xl font-semibold tracking-tight text-heading dark:text-white">xLLM</span>
        </div>
        <p class="mt-2 text-xs text-muted">Service &amp; Engine</p>
        <ul
          class="mt-4 flex flex-wrap justify-center gap-x-3 gap-y-1 border-t border-[#EB2700]/15 pt-3 text-[0.65rem] font-medium text-muted"
        >
          <li>Scheduling</li><li>KV cache</li><li>Graph execution</li>
        </ul>
      </div>
    </div>

    <div class="flow-connector" aria-hidden="true"><Icon name="tabler:chevron-right" class="h-4 w-4" /></div>

    <div class="flow-endpoint">
      <p class="flow-label"><span>03</span> Accelerators</p>
      <ul class="grid grid-cols-3 gap-2 sm:grid-cols-1">
        {
          hardwareTypes.map((hardware) => (
            <li class="flex items-center justify-center gap-2 rounded-lg border border-black/[0.07] bg-white px-3 py-2 font-mono text-sm font-medium dark:border-white/10 dark:bg-neutral-900">
              <Icon name="tabler:cpu-2" class="hidden h-4 w-4 text-muted sm:block" />
              {hardware}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <figcaption
    class="mt-6 border-t border-black/[0.06] pt-4 text-center text-xs leading-relaxed text-muted dark:border-white/10"
  >
    A unified service and engine layer, with hardware-specific backends.
    <a href="#support" class="underline decoration-current/30 underline-offset-4 hover:text-primary"
      >Explore model and hardware support</a
    >
  </figcaption>
</figure>

<style>
  .inference-flow {
    background-image: radial-gradient(rgb(128 128 128 / 0.1) 0.7px, transparent 0.7px);
    background-size: 16px 16px;
  }

  .flow-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
  }

  .flow-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    color: var(--aw-color-text-muted);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .flow-label span {
    font-family: monospace;
    opacity: 0.5;
  }

  .flow-connector {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2.5rem;
    color: var(--aw-color-primary);
  }

  .flow-connector :global(svg) {
    transform: rotate(90deg);
  }

  @media (min-width: 640px) {
    .flow-layout {
      grid-template-columns: minmax(0, 1fr) 2.5rem minmax(0, 1.6fr) 2.5rem minmax(0, 1fr);
    }

    .flow-connector {
      margin-top: 1.5rem;
    }

    .flow-connector::before {
      content: '';
      width: 100%;
      height: 1px;
      background: linear-gradient(to right, rgb(235 39 0 / 0.15), rgb(235 39 0 / 0.6));
    }

    .flow-connector :global(svg) {
      flex-shrink: 0;
      margin-left: -0.45rem;
      transform: none;
    }
  }
</style>
