---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';

interface Link {
  text?: string;
  href?: string;
  target?: string;
  ariaLabel?: string;
  icon?: string;
}

interface FooterGroup {
  title: string;
  links: Array<Link>;
}

export interface Props {
  socialLinks: Array<Link>;
  copyright?: string;
  footNote?: string;
  theme?: string;
  links?: Array<FooterGroup>;
}

const { socialLinks = [], copyright = '', footNote = '', theme = 'light', links = [] } = Astro.props;
---

<footer class:list={[{ dark: theme === 'dark' }, 'relative border-t border-gray-200 dark:border-slate-800 not-prose']}>
  <div class="dark:bg-dark absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 dark:text-slate-300">
    <div class="grid gap-10 py-12 md:grid-cols-[1.5fr_1fr_1fr] md:gap-12 md:py-14">
      <div class="max-w-sm">
        <a class="inline-flex items-center" href="/" aria-label="xLLM home">
          <Logo />
        </a>
        <p class="mt-4 text-sm leading-relaxed text-muted dark:text-gray-400">
          High-performance inference engine across heterogeneous accelerators for many models.
        </p>
      </div>

      {
        links.map((group) => (
          <nav aria-label={group.title}>
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-muted dark:text-gray-400">{group.title}</p>
            <ul class="mt-4 space-y-3">
              {group.links.map((link) => (
                <li>
                  <a
                    class="inline-flex text-sm font-medium text-heading transition-colors hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:text-gray-300"
                    href={link.href}
                    target={link.target}
                    rel={link.target === '_blank' ? 'noopener noreferrer' : undefined}
                  >
                    {link.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="flex flex-col gap-4 border-t border-gray-200/80 py-6 md:flex-row md:items-center md:justify-between dark:border-slate-800"
    >
      <div class="text-sm text-muted dark:text-gray-400">
        {copyright}
        {footNote && <Fragment set:html={footNote} />}
      </div>

      {
        socialLinks?.length ? (
          <ul class="flex -ml-2 md:ml-4 rtl:ml-0 rtl:-mr-2 rtl:md:ml-0 rtl:md:mr-4">
            {socialLinks.map(({ ariaLabel, href, text, icon }) => (
              <li>
                <a
                  class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center transition-colors hover:text-accent"
                  aria-label={ariaLabel}
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {icon && <Icon name={icon} class="w-5 h-5" />}
                  <Fragment set:html={text} />
                </a>
              </li>
            ))}
          </ul>
        ) : (
          ''
        )
      }
    </div>
  </div>
</footer>
