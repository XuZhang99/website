---
import { Icon } from 'astro-icon/components';

interface SupportItem {
  name: string;
  logo?: string;
  monogram?: string;
}

interface Props {
  title: string;
  icon: string;
  items: SupportItem[];
  href: string;
  linkText: string;
  columns?: 2 | 3;
  divided?: boolean;
}

const { title, icon, items, href, linkText, columns = 2, divided = false } = Astro.props;
---

<article
  class:list={[
    'scroll-fade flex flex-col lg:px-6',
    { 'border-t border-neutral-200 pt-6 lg:border-l lg:border-t-0 lg:pt-0 dark:border-neutral-800': divided },
  ]}
>
  <h3 class="flex items-center justify-center gap-2 text-sm font-semibold text-muted">
    <Icon name={icon} class="h-4 w-4" />
    {title}
  </h3>
  <ul class:list={['my-5 grid gap-x-3 gap-y-5', columns === 3 ? 'grid-cols-3' : 'grid-cols-2']}>
    {
      items.map((item) => (
        <li class="flex flex-col items-center text-center">
          <span class="mb-2 flex h-12 w-12 items-center justify-center rounded-xl bg-white ring-1 ring-black/[0.04]">
            {item.logo ? (
              <img
                src={item.logo}
                alt=""
                width="32"
                height="32"
                loading="lazy"
                decoding="async"
                class="h-8 w-8 object-contain"
              />
            ) : (
              <span class="font-mono text-xl font-semibold tracking-tight text-neutral-800" aria-hidden="true">
                {item.monogram}
              </span>
            )}
          </span>
          <p class="text-sm font-semibold leading-snug text-heading dark:text-white">{item.name}</p>
        </li>
      ))
    }
  </ul>
  <div class="mt-auto flex justify-center">
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex items-center gap-2 rounded text-sm font-semibold text-muted transition-colors hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
    >
      {linkText}
      <Icon
        name="tabler:arrow-right"
        class="h-4 w-4 motion-safe:transition-transform motion-safe:group-hover:translate-x-1"
      />
    </a>
  </div>
</article>
