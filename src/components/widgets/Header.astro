---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import LanguageSwitcher from '~/components/common/LanguageSwitcher.astro';
import Button from '~/components/ui/Button.astro';

import { localeMeta, type Locale } from '~/utils/i18n';

import { getHomePermalink, getPermalink, trimSlash, getAsset } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  target?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
  locale?: Locale;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
  locale = 'en',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
const localeText = localeMeta[locale];
---

<header
  class:list={[
    { sticky: isSticky, relative: !isSticky, dark: isDark },
    'top-0 z-40 flex-none mx-auto w-full border-b border-gray-50/0 transition-[opacity] ease-in-out',
  ]}
  {...isSticky ? { 'data-aw-sticky-header': true } : {}}
  {...id ? { id } : {}}
>
  <div class="absolute inset-0"></div>
  <div
    class:list={[
      'relative text-default py-3 px-3 md:px-6 mx-auto w-full',
      {
        'md:flex md:justify-between': position !== 'center',
      },
      {
        'md:grid md:grid-cols-[auto_1fr_auto] md:items-center md:gap-3': position === 'center',
      },
      {
        'max-w-7xl': !isFullWidth,
      },
    ]}
  >
    <div class:list={[{ 'mr-auto rtl:mr-0 rtl:ml-auto': position === 'right' }, 'flex justify-between']}>
      <a class="flex items-center" href={locale === 'zh' ? getPermalink('/zh') : getHomePermalink()}>
        <Logo />
      </a>
      <div class="flex items-center md:hidden">
        <ToggleMenu label={localeText.menuLabel} />
      </div>
    </div>
    <nav
      class="items-center w-full md:w-auto hidden flex md:flex md:mx-0 text-default overflow-y-auto overflow-x-hidden md:overflow-y-visible md:overflow-x-auto md:justify-self-center"
      aria-label={localeText.mainNavLabel}
    >
      <ul
        class="flex flex-col md:flex-row md:self-center w-full md:w-auto text-xl md:text-sm tracking-[0.01rem] font-medium md:justify-center"
      >
        {
          links.map(({ text, href, target, links }) => (
            <li class={links?.length ? 'dropdown' : ''}>
              {links?.length ? (
                <>
                  <button
                    type="button"
                    class="hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap"
                  >
                    {text}{' '}
                    <Icon name="tabler:chevron-down" class="w-3.5 h-3.5 ml-0.5 rtl:ml-0 rtl:mr-0.5 hidden md:inline" />
                  </button>
                  <ul class="dropdown-menu md:backdrop-blur-md dark:md:bg-dark rounded md:absolute pl-4 md:pl-0 md:hidden font-medium md:bg-white/90 md:min-w-[200px] drop-shadow-xl">
                    {links.map(({ text: text2, href: href2, target: target2 }) => (
                      <li>
                        <a
                          class:list={[
                            'first:rounded-t last:rounded-b md:hover:bg-gray-100 hover:text-link dark:hover:text-white dark:hover:bg-gray-700 py-2 px-5 block whitespace-no-wrap',
                            { 'aw-link-active': href2 === currentPath },
                          ]}
                          href={href2}
                          target={target2}
                          rel={target2 === '_blank' ? 'noopener noreferrer' : undefined}
                        >
                          {text2}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  class:list={[
                    'rounded-lg px-3 py-2 flex items-center whitespace-nowrap transition-colors duration-200 hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary motion-reduce:transition-none',
                    { 'aw-link-active': href === currentPath },
                  ]}
                  href={href}
                  target={target}
                  rel={target === '_blank' ? 'noopener noreferrer' : undefined}
                >
                  {text}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    <div
      class:list={[
        { 'ml-auto rtl:ml-0 rtl:mr-auto': position === 'left' },
        'hidden md:self-center md:flex items-center md:mb-0 fixed w-full md:w-auto md:static justify-end left-0 rtl:left-auto rtl:right-0 bottom-0 border-t border-neutral-200 bg-white/95 p-3 backdrop-blur-md md:border-0 md:bg-transparent md:backdrop-blur-none md:p-0 md:justify-self-end dark:border-neutral-800 dark:bg-neutral-950/95 md:dark:bg-transparent',
      ]}
    >
      <div class="items-center flex justify-between w-full md:w-auto">
        <div class="flex">
          {
            showToggleTheme && (
              <ToggleTheme
                label={locale === 'zh' ? '切换深色/浅色模式' : 'Toggle between Dark and Light mode'}
                iconClass="w-6 h-6 md:w-5 md:h-5"
              />
            )
          }
          <LanguageSwitcher locale={locale} />
          {
            showRssFeed && (
              <a
                class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                aria-label="RSS Feed"
                href={getAsset('/rss.xml')}
              >
                <Icon name="tabler:rss" class="w-5 h-5" />
              </a>
            )
          }
        </div>
        {
          actions?.length ? (
            <span class="ml-2 rtl:ml-0 rtl:mr-2">
              {actions.map((btnProps) =>
                btnProps.githubRepo ? (
                  <a
                    class="btn-secondary inline-flex w-auto items-center gap-2 whitespace-nowrap py-2.5 px-3 text-sm font-semibold shadow-none md:px-4"
                    href={btnProps.href}
                    target={btnProps.target}
                    rel={btnProps.target === '_blank' ? 'noopener noreferrer' : undefined}
                    aria-label={locale === 'zh' ? 'GitHub 仓库' : `${btnProps.text ?? 'GitHub'} repository`}
                  >
                    {btnProps.icon && <Icon name={btnProps.icon} class="h-5 w-5" />}
                    <span>{btnProps.text}</span>
                    <span
                      class="hidden inline-flex items-center gap-1 border-l border-neutral-300 pl-2 text-xs font-semibold text-muted dark:border-neutral-600 dark:text-neutral-300"
                      data-github-stars-container
                    >
                      <Icon name="tabler:star-filled" class="h-4 w-4 text-amber-500" />
                      <span class="min-w-[3ch] tabular-nums" data-github-stars={btnProps.githubRepo} />
                    </span>
                  </a>
                ) : (
                  <Button {...btnProps} class="ml-2 py-2.5 px-5.5 md:px-6 font-semibold shadow-none text-sm w-auto" />
                )
              )}
            </span>
          ) : (
            ''
          )
        }
      </div>
    </div>
  </div>
</header>

<script>
  const starRequests = new Map<string, Promise<number | undefined>>();

  function loadStars(repo: string) {
    if (!starRequests.has(repo)) {
      starRequests.set(
        repo,
        fetch(`https://api.github.com/repos/${repo}`)
          .then(async (response) => {
            if (!response.ok) return;
            const data = await response.json();
            return typeof data.stargazers_count === 'number' ? data.stargazers_count : undefined;
          })
          .catch(() => undefined)
      );
    }
    return starRequests.get(repo)!;
  }

  function updateStars() {
    document.querySelectorAll<HTMLElement>('[data-github-stars]').forEach(async (element) => {
      const repo = element.dataset.githubStars;
      if (!repo) return;
      const stars = await loadStars(repo);
      if (stars !== undefined) {
        element.textContent = new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 }).format(
          stars
        );
        element.title = `${new Intl.NumberFormat('en-US').format(stars)} GitHub stars`;
        element.closest<HTMLElement>('[data-github-stars-container]')?.classList.remove('hidden');
      }
    });
  }

  document.addEventListener('astro:page-load', updateStars);
</script>
