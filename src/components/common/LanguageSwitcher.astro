---
import { localeMeta, getLocaleFromPathname, getLocalizedUrl } from '~/utils/i18n';
import type { Locale } from '~/utils/i18n';

export interface Props {
  locale?: Locale;
}

const currentLocale = Astro.props.locale ?? getLocaleFromPathname(Astro.url.pathname);
const current = localeMeta[currentLocale];

const languageLinks = (['en', 'zh'] as const).map((locale) => ({
  locale,
  ...localeMeta[locale],
  href: getLocalizedUrl(Astro.url, locale),
}));
---

<details class="language-menu" data-language-menu>
  <summary aria-label={current.switchLabel}>
    <svg aria-hidden="true" class="language-icon" height="16" viewBox="0 0 24 24" width="16">
      <path d="m5 8 6 6"></path>
      <path d="m4 14 6-6 2-3"></path>
      <path d="M2 5h12"></path>
      <path d="M7 2h1"></path>
      <path d="m22 22-5-10-5 10"></path>
      <path d="M14 18h6"></path>
    </svg>
    <span>{current.label}</span>
    <svg aria-hidden="true" class="chevron-icon" height="16" viewBox="0 0 24 24" width="16">
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </summary>

  <div class="language-options" role="menu">
    {
      languageLinks.map((language) => (
        <a
          href={language.href}
          role="menuitem"
          aria-current={language.locale === currentLocale ? 'true' : undefined}
          data-astro-reload
        >
          <span>{language.label}</span>
        </a>
      ))
    }
  </div>
</details>

<script>
  function syncLanguageLinks() {
    const { search, hash } = window.location;

    document.querySelectorAll<HTMLAnchorElement>('.language-options a').forEach((link) => {
      const url = new URL(link.href, window.location.href);
      url.search = search;
      url.hash = hash;
      link.setAttribute('href', `${url.pathname}${url.search}${url.hash}`);
    });
  }

  // Astro.url is captured at build time, so keep runtime search/fragment in sync.
  syncLanguageLinks();
  document.addEventListener('astro:page-load', syncLanguageLinks);
  window.addEventListener('hashchange', syncLanguageLinks);
  window.addEventListener('popstate', syncLanguageLinks);

  document.addEventListener(
    'click',
    (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest('.language-options a')) syncLanguageLinks();
    },
    true
  );

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    for (const menu of document.querySelectorAll('.language-menu[open]')) {
      if (!menu.contains(target) && menu instanceof HTMLDetailsElement) menu.open = false;
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;

    for (const menu of document.querySelectorAll('.language-menu[open]')) {
      if (menu instanceof HTMLDetailsElement) menu.open = false;
    }
  });
</script>

<style>
  .language-menu {
    position: relative;
  }

  .language-menu summary {
    align-items: center;
    background-clip: padding-box;
    border: 1px solid transparent;
    border-radius: 0.625rem;
    color: var(--aw-color-text-muted);
    cursor: pointer;
    display: flex;
    font-size: 0.875rem;
    font-weight: 500;
    gap: 0.35rem;
    line-height: 1;
    list-style: none;
    padding: 0.55rem 0.75rem;
    transform: scale(1);
    transform-origin: center;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease,
      transform 260ms cubic-bezier(0.34, 1.56, 0.64, 1);
    user-select: none;
    white-space: nowrap;
    will-change: transform;
  }

  .language-menu summary::-webkit-details-marker {
    display: none;
  }

  .language-menu summary:focus-visible {
    outline: none;
  }

  .language-menu summary:is(:hover, :focus-visible),
  .language-menu[open] summary {
    background-color: rgb(235 39 0 / 8%);
    border-color: rgb(235 39 0 / 26%);
    color: var(--aw-color-accent);
    transform: scale(1.045);
  }

  .language-menu svg {
    fill: none;
    flex: 0 0 auto;
    height: 1rem;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
    width: 1rem;
  }

  .language-menu .chevron-icon {
    transition: transform 160ms ease;
  }

  .language-menu[open] .chevron-icon {
    transform: rotate(180deg);
  }

  .language-options {
    background-color: color-mix(in srgb, var(--aw-color-bg-page) 96%, transparent);
    border: 1px solid rgb(0 0 0 / 10%);
    border-radius: 0.625rem;
    box-shadow: 0 0.85rem 2rem rgb(0 0 0 / 12%);
    display: grid;
    gap: 0.125rem;
    inset-block-start: calc(100% + 0.4rem);
    inset-inline-end: 0;
    min-width: 100%;
    padding: 0.25rem;
    position: absolute;
    z-index: 60;
  }

  .language-options a {
    border-radius: 0.5rem;
    color: var(--aw-color-text-muted);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1;
    padding: 0.55rem 0.75rem;
    text-align: start;
    text-decoration: none;
    white-space: nowrap;
  }

  .language-options a:is(:hover, :focus-visible),
  .language-options a[aria-current='true'] {
    background-color: rgb(235 39 0 / 10%);
    color: var(--aw-color-accent);
    outline: none;
  }

  :global(.dark) .language-options {
    border-color: rgb(255 255 255 / 12%);
    box-shadow: 0 0.85rem 2rem rgb(0 0 0 / 40%);
  }

  @media (max-width: 767px) {
    .language-options {
      inset-block-end: calc(100% + 0.4rem);
      inset-block-start: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .language-menu summary {
      transition:
        background-color 160ms ease,
        border-color 160ms ease,
        color 160ms ease;
    }

    .language-menu summary:is(:hover, :focus-visible),
    .language-menu[open] summary {
      transform: none;
    }

    .language-menu .chevron-icon {
      transition: none;
    }
  }
</style>
