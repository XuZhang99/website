---
import { randomBytes } from 'node:crypto';

import { UI } from 'astrowind:config';

// Animated sun/moon switch adapted from the Starlight Rapide theme used by docs.xllm-ai.com.

export interface Props {
  label?: string;
  class?: string;
}

const { label = 'Toggle between Dark and Light mode', class: className = '' } = Astro.props;
const maskId = `theme-toggle-moon-${randomBytes(4).toString('hex')}`;
---

{
  !(UI.theme && UI.theme.endsWith(':only')) && (
    <button
      type="button"
      class:list={['xllm-theme-toggle', className]}
      aria-label={label}
      aria-live="polite"
      title={label}
      data-aw-toggle-color-scheme
    >
      <svg aria-hidden="true" height="16" viewBox="0 0 24 24" width="16">
        <mask class="moon" id={maskId}>
          <rect x="0" y="0" width="100%" height="100%" fill="white" />
          <circle cx="24" cy="10" r="6" fill="black" />
        </mask>
        <circle class="sun" cx="12" cy="12" r="6" mask={`url(#${maskId})`} />
        <g class="sun-beams" stroke="currentColor">
          <line x1="12" y1="1" x2="12" y2="3" />
          <line x1="12" y1="21" x2="12" y2="23" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="1" y1="12" x2="3" y2="12" />
          <line x1="21" y1="12" x2="23" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </g>
      </svg>
    </button>
  )
}

<style is:global>
  .xllm-theme-toggle {
    align-items: center;
    background-color: transparent;
    border: 0;
    border-radius: 0.625rem;
    color: var(--aw-color-text-muted);
    cursor: pointer;
    display: inline-flex;
    height: 2.5rem;
    justify-content: center;
    margin-inline: 0.5rem;
    padding-inline: 0.75rem;
    transition: color 160ms ease;
  }

  .xllm-theme-toggle:is(:hover, :focus-visible) {
    color: var(--aw-color-primary);
  }

  .xllm-theme-toggle:focus-visible {
    outline: 2px solid var(--aw-color-primary);
    outline-offset: 2px;
  }

  .xllm-theme-toggle svg {
    display: block;
    stroke-linecap: round;
  }

  .xllm-theme-toggle svg :is(.moon, .sun, .sun-beams) {
    transform-origin: center;
  }

  .xllm-theme-toggle svg :is(.moon, .sun) {
    fill: currentColor;
  }

  .xllm-theme-toggle svg .sun-beams {
    stroke: currentColor;
    stroke-width: 2px;
  }

  .dark .xllm-theme-toggle svg .sun {
    transform: scale(1.75);
  }

  .dark .xllm-theme-toggle svg .sun-beams {
    opacity: 0;
  }

  .dark .xllm-theme-toggle svg .moon circle {
    transform: translateX(-7px);
  }

  @supports (cx: 1) {
    .dark .xllm-theme-toggle svg .moon circle {
      cx: 17;
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .xllm-theme-toggle svg .sun {
      transition: transform 400ms cubic-bezier(0.5, 1.25, 0.75, 1.25);
    }

    .xllm-theme-toggle svg .sun-beams {
      transition:
        opacity 400ms ease,
        transform 400ms cubic-bezier(0.5, 1.25, 0.75, 1.25);
    }

    .xllm-theme-toggle svg .moon circle {
      transition: transform 200ms ease-out;
    }

    @supports (cx: 1) {
      .xllm-theme-toggle svg .moon circle {
        transition: cx 200ms ease-out;
      }
    }

    .dark .xllm-theme-toggle svg .sun {
      transition-duration: 200ms;
      transition-timing-function: ease;
    }

    .dark .xllm-theme-toggle svg .sun-beams {
      transform: rotate(-25deg);
      transition-duration: 100ms;
    }

    .dark .xllm-theme-toggle svg .moon circle {
      transition-delay: 100ms;
      transition-duration: 400ms;
    }
  }
</style>
