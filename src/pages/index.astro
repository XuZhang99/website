---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import Button from '~/components/ui/Button.astro';
import { headerData } from '~/navigation';

const metadata = {
  title: 'xLLM',
  ignoreTitleTemplate: true,
};

const hardwareSupport = [
  {
    name: 'Ascend NPUs',
  },
  {
    name: 'Cambricon MLUs',
  },
  {
    name: 'Iluvatar CoreX GPUs',
  },
  {
    name: 'Moore Threads GPUs',
  },
];

const modelSupport = [
  {
    name: 'DeepSeek',
  },
  {
    name: 'Qwen',
  },
  {
    name: 'Kimi',
  },
  {
    name: 'GLM',
  },
  {
    name: 'Flux',
  },
  {
    name: 'OneRec',
  },
];
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header {...headerData} showToggleTheme />
  </Fragment>

  <section class="relative -mt-[76px] 2xl:-mt-[85px] not-prose">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(235,39,0,0.16),transparent_50%),radial-gradient(circle_at_80%_22%,rgba(235,39,0,0.16),transparent_52%),linear-gradient(to_bottom,rgba(235,39,0,0.08),rgba(248,250,252,0.92))] dark:bg-[radial-gradient(circle_at_top,rgba(235,39,0,0.18),transparent_50%),radial-gradient(circle_at_80%_22%,rgba(235,39,0,0.18),transparent_52%),linear-gradient(to_bottom,#080808,#080808)]"
      >
      </div>
    </div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
      <div class="pointer-events-none pt-[76px] 2xl:pt-[85px]"></div>
      <div class="pb-12 pt-10 md:pb-16 md:pt-14 lg:pt-16">
        <div class="scroll-fade-stagger mx-auto max-w-6xl text-center">
          <div class="flex items-center justify-center gap-3">
            <img src="/images/logo.png" alt="xLLM" class="h-12 w-auto" width="3194" height="1705" />
            <span class="border-l border-current/15 pl-3 text-xs font-medium uppercase tracking-[0.16em] text-muted">
              Open-source inference
            </span>
          </div>
          <h1
            class="mt-6 text-4xl font-semibold leading-[1.1] tracking-[-0.045em] text-heading sm:text-5xl lg:text-6xl dark:text-white"
          >
            <span class="block">High-performance inference.</span>
            <span class="mt-2 block text-primary">Across heterogeneous accelerators.</span>
          </h1>
          <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
            A unified framework for LLM, VLM, DiT, and REC models. Built for efficient inference across diverse AI
            hardware.
          </p>
          <div class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
            <Button
              variant="primary"
              text="Get Started"
              href="https://docs.xllm-ai.com/en/getting_started/quick_start/"
              target="_blank"
              icon="tabler:book-2"
              class="border-[#EB2700] bg-[#EB2700] text-white hover:border-[#EB2700] hover:bg-[#EB2700] dark:border-[#EB2700] dark:bg-[#EB2700] dark:hover:border-[#EB2700] dark:hover:bg-[#EB2700]"
            />
            <Button text="Explore support" href="#support" icon="tabler:arrow-down" />
          </div>
        </div>

        <div class="scroll-fade-stagger mx-auto mt-12 grid max-w-6xl gap-4 md:grid-cols-3">
          <div
            class="rounded-3xl border border-slate-200/80 bg-white/75 p-6 dark:border-slate-700 dark:bg-slate-900/50"
          >
            <h2 class="flex items-center gap-2 text-xl font-semibold text-heading dark:text-white">
              <Icon name="tabler:circle-check" class="h-5 w-5 text-[rgba(235,39,0,0.75)]" />
              Easy
            </h2>
            <p class="mt-3 text-sm text-muted md:text-base">
              Deploy open models with a unified service-engine stack and production-oriented tooling.
            </p>
          </div>
          <div
            class="rounded-3xl border border-slate-200/80 bg-white/75 p-6 dark:border-slate-700 dark:bg-slate-900/50"
          >
            <h2 class="flex items-center gap-2 text-xl font-semibold text-heading dark:text-white">
              <Icon name="tabler:bolt" class="h-5 w-5 text-[rgba(235,39,0,0.75)]" />
              Fast
            </h2>
            <p class="mt-3 text-sm text-muted md:text-base">
              Improve throughput with asynchronous scheduling, graph optimization, and multi-stream execution.
            </p>
          </div>
          <div
            class="rounded-3xl border border-slate-200/80 bg-white/75 p-6 dark:border-slate-700 dark:bg-slate-900/50"
          >
            <h2 class="flex items-center gap-2 text-xl font-semibold text-heading dark:text-white">
              <Icon name="tabler:coins" class="h-5 w-5 text-[rgba(235,39,0,0.75)]" />
              Cost Efficient
            </h2>
            <p class="mt-3 text-sm text-muted md:text-base">
              Reduce inference cost with hardware-aware optimization, efficient memory management, and global KV
              caching.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="support" class="not-prose">
    <div class="mx-auto max-w-7xl px-4 py-10 md:px-6 md:py-12 lg:py-16">
      <div class="scroll-fade mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-wide text-[rgba(235,39,0,0.75)]">Broad Support</p>
        <h2 class="mt-3 text-2xl font-bold tracking-tight text-heading md:text-3xl dark:text-white">
          Cross-Platform Model & Hardware Support
        </h2>
        <p class="mt-3 text-base text-muted md:text-lg">
          xLLM supports mainstream open models across heterogeneous accelerator targets.
        </p>
      </div>

      <div class="scroll-fade-stagger mx-auto mt-8 grid max-w-6xl items-stretch gap-5 lg:grid-cols-2">
        <article
          class="flex h-full flex-col rounded-3xl border border-slate-200/80 bg-white/75 p-6 dark:border-slate-700 dark:bg-slate-900/50"
        >
          <div class="text-center">
            <p
              class="inline-flex items-center justify-center gap-2 text-sm font-semibold uppercase tracking-wide text-[rgba(235,39,0,0.75)]"
            >
              <Icon name="tabler:server-2" class="h-4 w-4" />
              Supported Hardware
            </p>
          </div>

          <ul class="mt-5 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
            {
              hardwareSupport.map((item) => (
                <li class="flex min-h-12 items-center justify-center rounded-[8px] border border-slate-200/80 bg-slate-50/80 px-3.5 py-2 text-center shadow-sm dark:border-slate-700/80 dark:bg-slate-800/50">
                  <h4 class="text-base font-semibold leading-snug text-heading dark:text-white">{item.name}</h4>
                </li>
              ))
            }
          </ul>

          <div class="mt-auto flex justify-center pt-5">
            <a
              href="https://docs.xllm-ai.com/en/hardware/overview/"
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-1.5 text-sm font-semibold text-muted transition-colors duration-200 ease-out hover:text-[#EB2700] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#EB2700]/35 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900"
            >
              View all supported hardware
              <Icon
                name="tabler:arrow-right"
                class="h-4 w-4 transition-transform duration-200 ease-out group-hover:translate-x-1 group-focus-visible:translate-x-1 motion-reduce:transform-none motion-reduce:transition-none"
              />
            </a>
          </div>
        </article>

        <article
          class="flex h-full flex-col rounded-3xl border border-slate-200/80 bg-white/75 p-6 dark:border-slate-700 dark:bg-slate-900/50"
        >
          <div class="text-center">
            <p
              class="inline-flex items-center justify-center gap-2 text-sm font-semibold uppercase tracking-wide text-[rgba(235,39,0,0.75)]"
            >
              <Icon name="tabler:brain" class="h-4 w-4" />
              Supported Models
            </p>
          </div>

          <ul class="mt-5 grid grid-cols-2 gap-2.5 sm:grid-cols-3">
            {
              modelSupport.map((item) => (
                <li class="flex min-h-12 items-center justify-center rounded-[8px] border border-slate-200/80 bg-slate-50/80 px-3.5 py-2 text-center shadow-sm dark:border-slate-700/80 dark:bg-slate-800/50">
                  <h4 class="text-base font-semibold leading-snug text-heading dark:text-white">{item.name}</h4>
                </li>
              ))
            }
          </ul>

          <div class="mt-auto flex justify-center pt-5">
            <a
              href="https://docs.xllm-ai.com/en/supported_models/"
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-1.5 text-sm font-semibold text-muted transition-colors duration-200 ease-out hover:text-[#EB2700] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#EB2700]/35 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900"
            >
              View all supported models
              <Icon
                name="tabler:arrow-right"
                class="h-4 w-4 transition-transform duration-200 ease-out group-hover:translate-x-1 group-focus-visible:translate-x-1 motion-reduce:transform-none motion-reduce:transition-none"
              />
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section id="community" class="not-prose">
    <div class="mx-auto max-w-7xl px-4 py-10 md:px-6 md:py-12 lg:py-16">
      <div class="scroll-fade mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-wide text-[rgba(235,39,0,0.75)]">Got Questions?</p>
        <h2 class="mt-3 text-2xl font-bold tracking-tight text-heading md:text-3xl dark:text-white">
          We are here to help
        </h2>
        <p class="mt-3 text-base text-muted md:text-lg">
          Whether you are getting started or debugging a deployment, the public project resources are the fastest place
          to continue.
        </p>
      </div>

      <div class="scroll-fade-stagger mx-auto mt-8 grid max-w-6xl gap-4 md:grid-cols-3">
        <a
          href="https://docs.xllm-ai.com/en/"
          target="_blank"
          rel="noopener noreferrer"
          class="card-hover rounded-3xl border border-slate-200/80 bg-white/75 p-6 hover:border-slate-300 hover:bg-white dark:border-slate-700 dark:bg-slate-900/50 dark:hover:border-slate-600"
        >
          <h3 class="flex items-center gap-2 text-lg font-semibold text-heading dark:text-white">
            <Icon name="tabler:book-2" class="h-5 w-5 text-[rgba(235,39,0,0.75)]" />
            Documentation
          </h3>
          <p class="mt-3 text-sm text-muted md:text-base">
            Setup guides, features, launch flows, and reference material.
          </p>
        </a>
        <a
          href="https://github.com/jd-opensource/xllm/issues"
          target="_blank"
          rel="noopener noreferrer"
          class="card-hover rounded-3xl border border-slate-200/80 bg-white/75 p-6 hover:border-slate-300 hover:bg-white dark:border-slate-700 dark:bg-slate-900/50 dark:hover:border-slate-600"
        >
          <h3 class="flex items-center gap-2 text-lg font-semibold text-heading dark:text-white">
            <Icon name="tabler:message-circle" class="h-5 w-5 text-[rgba(235,39,0,0.75)]" />
            GitHub Issues
          </h3>
          <p class="mt-3 text-sm text-muted md:text-base">
            Bug reports, feature requests, and implementation questions.
          </p>
        </a>
        <a
          href="https://github.com/jd-opensource/xllm/graphs/contributors"
          target="_blank"
          rel="noopener noreferrer"
          class="card-hover rounded-3xl border border-slate-200/80 bg-white/75 p-6 hover:border-slate-300 hover:bg-white dark:border-slate-700 dark:bg-slate-900/50 dark:hover:border-slate-600"
        >
          <h3 class="flex items-center gap-2 text-lg font-semibold text-heading dark:text-white">
            <Icon name="tabler:users" class="h-5 w-5 text-[rgba(235,39,0,0.75)]" />
            Contributors
          </h3>
          <p class="mt-3 text-sm text-muted md:text-base">
            See the developers and maintainers contributing to the project.
          </p>
        </a>
      </div>
    </div>
  </section>

  <section id="resources" class="not-prose">
    <div class="mx-auto max-w-7xl px-4 py-10 md:px-6 md:py-12 lg:py-16">
      <div class="scroll-fade mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-wide text-[rgba(235,39,0,0.75)]">Resources</p>
        <h2 class="mt-3 text-2xl font-bold tracking-tight text-heading md:text-3xl dark:text-white">
          Explore docs, paper, and releases
        </h2>
        <p class="mt-3 text-base text-muted md:text-lg">Core project resources in one place.</p>
      </div>

      <div class="scroll-fade-stagger mx-auto mt-8 grid max-w-6xl gap-4 md:grid-cols-3">
        <a
          href="https://docs.xllm-ai.com/en/"
          target="_blank"
          rel="noopener noreferrer"
          class="card-hover rounded-3xl border border-slate-200/80 bg-white/75 p-6 hover:border-slate-300 hover:bg-white dark:border-slate-700 dark:bg-slate-900/50 dark:hover:border-slate-600"
        >
          <h3 class="flex items-center gap-2 text-lg font-semibold text-heading dark:text-white">
            <Icon name="tabler:book-2" class="h-5 w-5 text-[rgba(235,39,0,0.75)]" />
            Documentation
          </h3>
          <p class="mt-3 text-sm text-muted md:text-base">Guides, setup instructions, and feature docs.</p>
        </a>
        <a
          href="/publications"
          class="card-hover rounded-3xl border border-slate-200/80 bg-white/75 p-6 hover:border-slate-300 hover:bg-white dark:border-slate-700 dark:bg-slate-900/50 dark:hover:border-slate-600"
        >
          <h3 class="flex items-center gap-2 text-lg font-semibold text-heading dark:text-white">
            <Icon name="tabler:file-text" class="h-5 w-5 text-[rgba(235,39,0,0.75)]" />
            Publications
          </h3>
          <p class="mt-3 text-sm text-muted md:text-base">Read xLLM papers, reports, and supporting artifacts.</p>
        </a>
        <a
          href="https://quay.io/repository/jd_xllm/xllm-ai?tab=tags"
          target="_blank"
          rel="noopener noreferrer"
          class="card-hover rounded-3xl border border-slate-200/80 bg-white/75 p-6 hover:border-slate-300 hover:bg-white dark:border-slate-700 dark:bg-slate-900/50 dark:hover:border-slate-600"
        >
          <h3 class="flex items-center gap-2 text-lg font-semibold text-heading dark:text-white">
            <Icon name="tabler:brand-docker" class="h-5 w-5 text-[rgba(235,39,0,0.75)]" />
            Docker
          </h3>
          <p class="mt-3 text-sm text-muted md:text-base">
            Use published images as a starting point for deployment and development.
          </p>
        </a>
      </div>
    </div>
  </section>
</Layout>
