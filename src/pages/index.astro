---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import InferenceFlow from '~/components/widgets/InferenceFlow.astro';
import SupportGroup from '~/components/widgets/SupportGroup.astro';
import Button from '~/components/ui/Button.astro';
import { headerData } from '~/navigation';

const metadata = {
  title: 'xLLM',
  ignoreTitleTemplate: true,
};

const resources = [
  {
    title: 'Documentation',
    description: 'Set up your environment and launch your first model.',
    href: 'https://docs.xllm-ai.com/en/',
    icon: 'tabler:book-2',
  },
  {
    title: 'Publications',
    description: 'Explore the research and engineering behind xLLM.',
    href: '/publications',
    icon: 'tabler:file-text',
  },
  {
    title: 'Docker images',
    description: 'Find published images for deployment and development.',
    href: 'https://quay.io/repository/jd_xllm/xllm-ai?tab=tags',
    icon: 'tabler:brand-docker',
  },
];

const hardwareSupport = [
  { name: 'Ascend', logo: '/images/brands/ascend.png' },
  { name: 'Cambricon', logo: '/images/brands/cambricon.ico' },
  { name: 'NVIDIA', logo: '/images/brands/nvidia.svg' },
  { name: 'Iluvatar CoreX', logo: '/images/brands/iluvatar.png' },
  { name: 'Moore Threads', logo: '/images/brands/moore-threads.png' },
  { name: 'Hygon', logo: '/images/brands/hygon.ico' },
];

const modelSupport = [
  { name: 'DeepSeek', logo: '/images/brands/deepseek.svg' },
  { name: 'Qwen', logo: '/images/brands/qwen.svg' },
  { name: 'Kimi', logo: '/images/brands/kimi.svg' },
  { name: 'GLM', logo: '/images/brands/glm.svg' },
  { name: 'Flux', logo: '/images/brands/flux.svg' },
  { name: 'OneRec', monogram: '1R' },
];
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header {...headerData} showToggleTheme />
  </Fragment>

  <section class="relative -mt-[76px] 2xl:-mt-[85px] not-prose">
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
      <div class="pointer-events-none pt-[76px] 2xl:pt-[85px]"></div>
      <div class="pb-12 pt-10 md:pb-16 md:pt-14 lg:pt-16">
        <div class="scroll-fade-stagger mx-auto max-w-6xl text-center">
          <img src="/images/logo.png" alt="xLLM" class="mx-auto h-32 w-auto md:h-48" width="3194" height="1705" />
          <h1
            class="mt-6 text-2xl font-semibold leading-tight tracking-tight text-heading sm:text-3xl lg:text-[2.5rem] lg:leading-tight dark:text-white"
          >
            <span class="block">High-performance inference.</span>
            <span class="mt-2 block text-primary">Across heterogeneous accelerators.</span>
          </h1>
          <p class="mx-auto mt-6 max-w-2xl text-balance text-base leading-relaxed text-muted sm:text-lg">
            A unified framework for <strong class="font-bold text-primary">LLM</strong>, <strong
              class="font-bold text-primary">VLM</strong
            >, <strong class="font-bold text-primary">DiT</strong>, and <strong class="font-bold text-primary"
              >REC</strong
            >
            models. Built for efficient inference across diverse AI hardware.
          </p>
          <div class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
            <Button
              variant="primary"
              text="Get Started"
              href="https://docs.xllm-ai.com/en/getting_started/quick_start/"
              target="_blank"
              icon="tabler:book-2"
            />
            <Button text="Explore support" href="#support" icon="tabler:arrow-down" />
          </div>
        </div>

        <InferenceFlow />

        <div class="scroll-fade-stagger mx-auto mt-12 grid max-w-6xl gap-4 md:grid-cols-3">
          <div class="border-t border-neutral-200 px-2 py-6 dark:border-neutral-800">
            <h2 class="flex items-center gap-2 text-xl font-semibold text-heading dark:text-white">
              <Icon name="tabler:circle-check" class="h-5 w-5 text-accent" />
              Easy
            </h2>
            <p class="mt-3 text-sm text-muted md:text-base">
              Bring models into your applications with OpenAI-compatible and Anthropic-compatible APIs for online
              serving.
            </p>
          </div>
          <div class="border-t border-neutral-200 px-2 py-6 dark:border-neutral-800">
            <h2 class="flex items-center gap-2 text-xl font-semibold text-heading dark:text-white">
              <Icon name="tabler:bolt" class="h-5 w-5 text-accent" />
              Fast
            </h2>
            <p class="mt-3 text-sm text-muted md:text-base">
              Keep accelerators busy with continuous batching, task pipelining, and graph execution to reduce runtime
              overhead and improve throughput.
            </p>
          </div>
          <div class="border-t border-neutral-200 px-2 py-6 dark:border-neutral-800">
            <h2 class="flex items-center gap-2 text-xl font-semibold text-heading dark:text-white">
              <Icon name="tabler:coins" class="h-5 w-5 text-accent" />
              Cost Efficient
            </h2>
            <p class="mt-3 text-sm text-muted md:text-base">
              Reuse prompt prefixes and extend KV caching across device memory, host memory, and distributed storage to
              reduce repeated computation and memory pressure.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="support" class="not-prose border-y border-neutral-200/70 bg-page dark:border-neutral-800">
    <div class="mx-auto max-w-7xl px-4 py-10 md:px-6 md:py-12 lg:py-16">
      <div class="scroll-fade mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-wide text-accent">Broad Support</p>
        <h2 class="mt-3 text-2xl font-bold tracking-tight text-heading md:text-3xl dark:text-white">
          Cross-Platform Model & Hardware Support
        </h2>
      </div>

      <div class="mx-auto mt-8 grid max-w-5xl gap-6 lg:grid-cols-2 lg:gap-0">
        <SupportGroup
          title="Supported hardware"
          icon="tabler:server-2"
          items={hardwareSupport}
          columns={3}
          href="https://docs.xllm-ai.com/en/hardware/overview/"
          linkText="View all supported hardware"
        />
        <SupportGroup
          title="Supported models"
          icon="tabler:brain"
          items={modelSupport}
          columns={3}
          href="https://docs.xllm-ai.com/en/supported_models/"
          linkText="View all supported models"
          divided
        />
      </div>
    </div>
  </section>

  <section id="resources" aria-labelledby="resources-heading" class="not-prose">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 py-14 sm:px-6 md:grid-cols-[1fr_1.5fr] md:gap-16 md:py-20">
      <div class="scroll-fade">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent">Resources</p>
        <h2
          id="resources-heading"
          class="mt-4 text-3xl font-semibold tracking-tight text-heading md:text-4xl dark:text-white"
        >
          Build with xLLM.
        </h2>
        <p class="mt-4 max-w-sm text-base leading-relaxed text-muted">
          From your first deployment to a deeper look at the engine. Start here.
        </p>
      </div>
      <ul
        class="scroll-fade divide-y divide-neutral-200 border-y border-neutral-200 dark:divide-neutral-800 dark:border-neutral-800"
      >
        {
          resources.map((resource) => (
            <li>
              <a
                href={resource.href}
                target={resource.href.startsWith('https:') ? '_blank' : undefined}
                rel={resource.href.startsWith('https:') ? 'noopener noreferrer' : undefined}
                class="group flex items-center gap-4 rounded-lg px-2 py-6 transition-colors hover:bg-neutral-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary dark:hover:bg-white/5 sm:gap-5"
              >
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-neutral-100 text-muted transition-colors group-hover:bg-[#EB2700]/10 group-hover:text-primary dark:bg-white/5">
                  <Icon name={resource.icon} class="h-5 w-5" />
                </span>
                <div class="flex-1">
                  <h3 class="text-lg font-semibold text-heading dark:text-white">{resource.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-muted">{resource.description}</p>
                </div>
                <Icon
                  name="tabler:arrow-up-right"
                  class="h-5 w-5 shrink-0 text-muted transition-colors group-hover:text-primary"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="community" aria-labelledby="community-heading" class="not-prose px-4 pb-16 sm:px-6 md:pb-20">
    <div
      class="scroll-fade relative mx-auto flex max-w-7xl flex-col gap-8 overflow-hidden rounded-3xl border border-neutral-200 bg-surface p-7 sm:p-10 lg:flex-row lg:items-center lg:justify-between lg:p-12 dark:border-neutral-800"
    >
      <div class="max-w-xl">
        <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-accent">
          <Icon name="tabler:brand-github" class="h-4 w-4" /> Community
        </p>
        <h2
          id="community-heading"
          class="mt-4 text-3xl font-semibold tracking-tight text-heading md:text-4xl dark:text-white"
        >
          Built in the open.<br />Better together.
        </h2>
        <p class="mt-4 text-base leading-relaxed text-muted">
          Ask a question, share an idea, or contribute to the next improvement. Help shape the future of xLLM.
        </p>
      </div>
      <div class="flex shrink-0 flex-col items-stretch gap-3 sm:flex-row sm:items-center lg:flex-col lg:items-stretch">
        <Button
          variant="primary"
          text="Join the conversation"
          href="https://github.com/jd-opensource/xllm/issues"
          target="_blank"
          icon="tabler:arrow-up-right"
        />
        <Button
          text="Meet the contributors"
          href="https://github.com/jd-opensource/xllm/graphs/contributors"
          target="_blank"
          icon="tabler:users"
        />
      </div>
    </div>
  </section>
</Layout>
