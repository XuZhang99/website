---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import InferenceFlow from '~/components/widgets/InferenceFlow.astro';
import SupportGroup from '~/components/widgets/SupportGroup.astro';
import Button from '~/components/ui/Button.astro';

const metadata = {
  title: 'xLLM',
  ignoreTitleTemplate: true,
  description: 'xLLM 是面向异构 AI 加速器优化的高性能推理框架，支持 LLM、VLM、DiT 与 REC 模型的高效推理。',
  openGraph: { locale: 'zh_CN' },
};

const resources = [
  {
    title: '文档',
    description: '配置环境并启动你的第一个模型。',
    href: 'https://docs.xllm-ai.com/zh/',
    icon: 'tabler:book-2',
  },
  {
    title: '论文',
    description: '了解 xLLM 背后的研究与工程实践。',
    href: '/zh/publications',
    icon: 'tabler:file-text',
  },
  {
    title: 'Docker 镜像',
    description: '获取用于部署和开发的已发布镜像。',
    href: 'https://quay.io/repository/jd_xllm/xllm-ai?tab=tags',
    icon: 'tabler:brand-docker',
  },
];

const hardwareSupport = [
  { name: 'Ascend', logo: '/images/brands/ascend.png' },
  { name: 'Cambricon', logo: '/images/brands/cambricon.ico' },
  { name: 'NVIDIA', logo: '/images/brands/nvidia.svg' },
  { name: 'Iluvatar CoreX', logo: '/images/brands/iluvatar.png' },
  { name: 'Moore Threads', logo: '/images/brands/moore-threads.png' },
  { name: 'Hygon', logo: '/images/brands/hygon.ico' },
];

const modelSupport = [
  { name: 'DeepSeek', logo: '/images/brands/deepseek.svg' },
  { name: 'Qwen', logo: '/images/brands/qwen.svg' },
  { name: 'Kimi', logo: '/images/brands/kimi.svg' },
  { name: 'GLM', logo: '/images/brands/glm.svg' },
  { name: 'Flux', logo: '/images/brands/flux.svg' },
  { name: 'OneRec', monogram: '1R' },
];
---

<Layout metadata={metadata} locale="zh">
  <section class="relative -mt-[76px] 2xl:-mt-[85px] not-prose">
    <div class="hero-ambient pointer-events-none absolute inset-x-0 top-0 h-[780px]" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
      <div class="pointer-events-none pt-[76px] 2xl:pt-[85px]"></div>
      <div class="pb-12 pt-10 md:pb-16 md:pt-14 lg:pt-16">
        <div class="scroll-fade-stagger mx-auto max-w-6xl text-center">
          <div class="py-4 md:py-5">
            <img
              src="/images/logo-wordmark.png"
              alt="xLLM"
              class="mx-auto block h-[4.5rem] w-auto md:h-[6.5rem]"
              width="1200"
              height="374"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
          <h1
            class="mt-7 text-[1.75rem] font-semibold leading-[1.15] tracking-tight text-heading sm:text-4xl lg:text-[2.75rem] dark:text-white"
          >
            <span class="block">高性能推理引擎</span>
            <span class="mt-3 block text-primary">支持主流异构硬件</span>
          </h1>
          <p class="mx-auto mt-6 max-w-2xl text-balance text-base leading-relaxed text-muted sm:text-lg">
            统一支持 <strong class="font-bold text-primary">LLM</strong>、<strong class="font-bold text-primary"
              >VLM</strong
            >、<strong class="font-bold text-primary">DiT</strong> 与 <strong class="font-bold text-primary">REC</strong
            >
            模型，为多样化异构硬件提供高效推理
          </p>
          <div class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
            <Button
              variant="primary"
              text="快速开始"
              href="https://docs.xllm-ai.com/zh/getting_started/quick_start/"
              target="_blank"
              icon="tabler:book-2"
              class="sm:min-w-[10rem]"
            />
            <Button text="了解支持范围" href="#support" icon="tabler:arrow-down" class="sm:min-w-[10rem]" />
          </div>
        </div>

        <InferenceFlow locale="zh" />

        <div
          class="scroll-fade mx-auto mt-10 grid max-w-6xl divide-y divide-neutral-200/80 overflow-hidden rounded-2xl border border-neutral-200/80 bg-white/60 md:mt-12 md:grid-cols-3 md:divide-x md:divide-y-0 dark:divide-neutral-800 dark:border-neutral-800 dark:bg-white/[0.02]"
        >
          <div class="p-6 md:p-7">
            <h2 class="flex items-center gap-3 text-lg font-semibold text-heading dark:text-white">
              <span
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#EB2700]/[0.07] text-accent ring-1 ring-[#EB2700]/10 dark:bg-[#EB2700]/10"
              >
                <Icon name="tabler:circle-check" class="h-[18px] w-[18px]" />
              </span>
              易用
            </h2>
            <p class="mt-4 text-sm leading-relaxed text-muted md:text-[0.95rem]">
              通过兼容 OpenAI 与 Anthropic 的 API，将模型快速接入你的在线服务。
            </p>
          </div>
          <div class="p-6 md:p-7">
            <h2 class="flex items-center gap-3 text-lg font-semibold text-heading dark:text-white">
              <span
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#EB2700]/[0.07] text-accent ring-1 ring-[#EB2700]/10 dark:bg-[#EB2700]/10"
              >
                <Icon name="tabler:bolt" class="h-[18px] w-[18px]" />
              </span>
              高效
            </h2>
            <p class="mt-4 text-sm leading-relaxed text-muted md:text-[0.95rem]">
              通过连续批处理、任务流水线与图执行，让加速器保持高利用率，降低运行时开销并提升吞吐。
            </p>
          </div>
          <div class="p-6 md:p-7">
            <h2 class="flex items-center gap-3 text-lg font-semibold text-heading dark:text-white">
              <span
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#EB2700]/[0.07] text-accent ring-1 ring-[#EB2700]/10 dark:bg-[#EB2700]/10"
              >
                <Icon name="tabler:coins" class="h-[18px] w-[18px]" />
              </span>
              低成本
            </h2>
            <p class="mt-4 text-sm leading-relaxed text-muted md:text-[0.95rem]">
              复用提示前缀，并将 KV 缓存扩展至显存、主机内存与分布式存储，减少重复计算与内存压力。
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="support" class="not-prose scroll-mt-24 border-y border-neutral-200/70 bg-page dark:border-neutral-800">
    <div class="mx-auto max-w-7xl px-4 py-10 md:px-6 md:py-12 lg:py-16">
      <div class="scroll-fade mx-auto max-w-3xl text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent">广泛支持</p>
        <h2 class="mt-3 text-2xl font-semibold tracking-tight text-heading md:text-3xl dark:text-white">
          跨平台模型与硬件支持
        </h2>
      </div>

      <div class="mx-auto mt-10 grid max-w-5xl gap-6 lg:grid-cols-2 lg:gap-0">
        <SupportGroup
          title="支持的硬件"
          icon="tabler:server-2"
          items={hardwareSupport}
          columns={3}
          href="https://docs.xllm-ai.com/zh/hardware/overview/"
          linkText="查看全部支持的硬件"
        />
        <SupportGroup
          title="支持的模型"
          icon="tabler:brain"
          items={modelSupport}
          columns={3}
          href="https://docs.xllm-ai.com/zh/supported_models/"
          linkText="查看全部支持的模型"
          divided
        />
      </div>
    </div>
  </section>

  <section id="resources" aria-labelledby="resources-heading" class="not-prose scroll-mt-24">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 py-14 sm:px-6 md:grid-cols-[1fr_1.5fr] md:gap-16 md:py-20">
      <div class="scroll-fade">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent">资源</p>
        <h2
          id="resources-heading"
          class="mt-4 text-3xl font-semibold tracking-tight text-heading md:text-4xl dark:text-white"
        >
          使用 xLLM 构建
        </h2>
        <p class="mt-4 max-w-sm text-base leading-relaxed text-muted">从首次部署到深入了解引擎，从这里开始。</p>
      </div>
      <ul
        class="scroll-fade divide-y divide-neutral-200 border-y border-neutral-200 dark:divide-neutral-800 dark:border-neutral-800"
      >
        {
          resources.map((resource) => (
            <li>
              <a
                href={resource.href}
                target={resource.href.startsWith('https:') ? '_blank' : undefined}
                rel={resource.href.startsWith('https:') ? 'noopener noreferrer' : undefined}
                class="group flex items-center gap-4 rounded-lg px-2 py-6 transition-colors hover:bg-neutral-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary dark:hover:bg-white/5 sm:gap-5"
              >
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-neutral-100 text-muted transition-colors group-hover:bg-[#EB2700]/10 group-hover:text-primary dark:bg-white/5">
                  <Icon name={resource.icon} class="h-5 w-5" />
                </span>
                <div class="flex-1">
                  <h3 class="text-lg font-semibold text-heading dark:text-white">{resource.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-muted">{resource.description}</p>
                </div>
                <Icon
                  name={resource.href.startsWith('https:') ? 'tabler:arrow-up-right' : 'tabler:arrow-right'}
                  class="h-5 w-5 shrink-0 text-muted transition-colors group-hover:text-primary"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section
    id="community"
    aria-labelledby="community-heading"
    class="not-prose scroll-mt-24 px-4 pb-16 sm:px-6 md:pb-20"
  >
    <div
      class="scroll-fade relative mx-auto flex max-w-7xl flex-col gap-8 overflow-hidden rounded-3xl border border-neutral-200 bg-surface p-7 sm:p-10 lg:flex-row lg:items-center lg:justify-between lg:p-12 dark:border-neutral-800"
    >
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div
          class="absolute -right-24 -top-32 h-80 w-80 rounded-full bg-[radial-gradient(closest-side,rgba(235,39,0,0.16),transparent)] blur-2xl dark:opacity-70"
        >
        </div>
        <div class="community-grid absolute inset-y-0 right-0 w-2/3"></div>
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#EB2700]/30 to-transparent">
        </div>
      </div>
      <div class="relative z-10 max-w-xl">
        <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-accent">
          <Icon name="tabler:brand-github" class="h-4 w-4" /> 社区
        </p>
        <h2
          id="community-heading"
          class="mt-4 text-3xl font-semibold tracking-tight text-heading md:text-4xl dark:text-white"
        >
          开源共建 <br />一起做得更好
        </h2>
        <p class="mt-4 text-base leading-relaxed text-muted">
          提出问题、分享想法，或参与下一次改进，共同塑造 xLLM 的未来。
        </p>
      </div>
      <div
        class="relative z-10 flex shrink-0 flex-col items-stretch gap-3 sm:flex-row sm:items-center lg:flex-col lg:items-stretch"
      >
        <Button
          variant="primary"
          text="参与讨论"
          href="https://github.com/jd-opensource/xllm/issues"
          target="_blank"
          icon="tabler:arrow-up-right"
        />
        <Button text="认识贡献者" href="/zh/team" icon="tabler:users" />
      </div>
    </div>
  </section>
</Layout>
